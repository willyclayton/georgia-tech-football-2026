{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/pulse", "schedule": "0 16 * * 6" },
    { "path": "/api/pulse", "schedule": "0 12 * * 0" }
  ]
}
